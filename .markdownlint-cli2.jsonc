{
  "$schema": "./node_modules/markdownlint-cli2/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "MD013": false,
    "MD010": {
      "code_blocks": false
    },
    "MD024": {
      "siblings_only": true
    }
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**"
  ]
}
